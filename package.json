{
  "name": "dsh-llm-neuralwatt",
  "version": "0.1.0",
  "description": "Neuralwatt LLM provider plugin for DeepSeek Harness — dynamic model discovery with capability mapping over an OpenAI-compatible API",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "neuralwatt"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "Kaushal M <kaushal.m@proton.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kshlm/dsh-neuralwatt-provider.git"
  },
  "bugs": {
    "url": "https://github.com/kshlm/dsh-neuralwatt-provider/issues"
  },
  "homepage": "https://github.com/kshlm/dsh-neuralwatt-provider#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/local-smoke.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
